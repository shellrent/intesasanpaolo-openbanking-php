# Settings of the integration tests (docs/testing.md).
# Copy to env/integration.env, which git ignores. Real environment variables take precedence.
# Never commit credentials, certificates or real data.

# "sandbox" or "live"
ISP_ENVIRONMENT=sandbox

# OAuth2 client of the SmartHub app (separate for sandbox and Live)
ISP_CLIENT_ID=
ISP_CLIENT_SECRET=

# mTLS certificate: a .p12 file, or a PEM certificate with ISP_PRIVATE_KEY (README, "Certificato")
ISP_CERTIFICATE=
ISP_PRIVATE_KEY=
ISP_CERTIFICATE_PASSPHRASE=

# Live only: confirms the read-only run, and the account to read
ISP_LIVE_READ_ONLY=
ISP_IBAN=

# Live only, optional: holder of ISP_IBAN, for the holder verification
ISP_VAT_NUMBER=
ISP_FISCAL_CODE=
